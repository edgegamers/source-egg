{
    "_comment": "Generated for Pelican/Pterodactyl import. Runtime validation against real game clients remains required.",
    "meta": {
        "version": "PTDL_v2",
        "update_url": "https://raw.githubusercontent.com/edgegamers/source-egg/main/pterodactyl/source-egg.json"
    },
    "exported_at": "2026-10-24T00:00:00-05:00",
    "name": "Source Engine",
    "author": "support@edgegamers.com",
    "description": "Source Engine: CS:GO standalone, CS:S, DOD:S, L4D2, TF2. Optional node-managed base VPK sharing, Metamod stable and SourceMod prerelease cache. No Workshop/map cache or connection guard.",
    "icon": "data:image/png;base64,",
    "features": [
        "steam_disk_space"
    ],
    "docker_images": {
        "Source Engine (stable)": "ghcr.io/edgegamers/source-egg:stable",
        "Source Engine (beta)": "ghcr.io/edgegamers/source-egg:beta"
    },
    "file_denylist": [],
    "startup": "sourceegg",
    "config": {
        "files": "{}",
        "startup": "{\"done\":\"SourceEgg | Ready\"}",
        "logs": "{}",
        "stop": "quit"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\nset -euo pipefail\necho 'Source Egg installs the selected game on first startup.'\n",
            "container": "debian:bookworm-slim",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Game",
            "description": "Choose before first start. Existing installations cannot switch game/branch in place.",
            "env_variable": "SOURCE_GAME",
            "default_value": "CS:S",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|string|in:CS:GO,CS:S,DOD:S,L4D2,TF2",
            "field_type": "text"
        },
        {
            "name": "Installation mode",
            "description": "Auto uses the node when present. Managed requires it; standalone keeps private game files.",
            "env_variable": "SOURCE_MODE",
            "default_value": "auto",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|string|in:auto,managed,standalone",
            "field_type": "text"
        },
        {
            "name": "Steam branch",
            "description": "Steam game branch; separate installation identities. Usually public.",
            "env_variable": "STEAM_BRANCH",
            "default_value": "public",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|string|regex:/^[A-Za-z0-9_-]{1,64}$/",
            "field_type": "text"
        },
        {
            "name": "Map",
            "description": "Leave empty for the selected game's default map.",
            "env_variable": "SRCDS_MAP",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|regex:/^[A-Za-z0-9_-]{1,64}$/",
            "field_type": "text"
        },
        {
            "name": "Hostname",
            "description": "Server name.",
            "env_variable": "SERVER_HOSTNAME",
            "default_value": "Source Server",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        },
        {
            "name": "Maximum players",
            "description": "Subject to the selected game's limits; L4D2 game modes impose their own limits.",
            "env_variable": "MAX_PLAYERS",
            "default_value": "16",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|integer|between:1,128",
            "field_type": "text"
        },
        {
            "name": "Join password",
            "description": "Manual sv_password when generated passwords are off.",
            "env_variable": "SERVER_PASSWORD",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        },
        {
            "name": "RCON password",
            "description": "Independent from generated join passwords.",
            "env_variable": "RCON_PASSWORD",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        },
        {
            "name": "GSLT",
            "description": "Where required. CS:GO standalone token must match client app 4465480.",
            "env_variable": "STEAM_GSLT",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        },
        {
            "name": "Generate join password",
            "description": "Opt in to node-generated join passwords. Requires a node; fails closed without an assignment.",
            "env_variable": "GENERATE_PASSWORD",
            "default_value": "0",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
            "name": "Password sharing",
            "description": "Default follows node config (game). Game shares within a game on this node; server is unique; node shares all opted-in servers.",
            "env_variable": "PASSWORD_SCOPE",
            "default_value": "default",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|string|in:default,game,server,node",
            "field_type": "text"
        },
        {
            "name": "Game auto update",
            "description": "Standalone startup update. Shared-game checks are controlled by the node.",
            "env_variable": "AUTO_UPDATE",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
            "name": "Validate game files",
            "description": "Standalone SteamCMD validate on startup.",
            "env_variable": "STEAM_VALIDATE",
            "default_value": "0",
            "user_viewable": true,
            "user_editable": false,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
            "name": "Install Metamod",
            "description": "Track Metamod stable. SourceMod automatically requires Metamod.",
            "env_variable": "INSTALL_METAMOD",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
            "name": "Metamod version",
            "description": "Exact upstream release tag, or empty for latest stable.",
            "env_variable": "METAMOD_VERSION",
            "default_value": "",
            "user_viewable": true,
            "user_editable": false,
            "rules": "nullable|string|max:80",
            "field_type": "text"
        },
        {
            "name": "Install SourceMod",
            "description": "Track latest SourceMod prerelease.",
            "env_variable": "INSTALL_SOURCEMOD",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|boolean",
            "field_type": "text"
        },
        {
            "name": "SourceMod version",
            "description": "Exact upstream release tag, or empty for latest prerelease.",
            "env_variable": "SOURCEMOD_VERSION",
            "default_value": "",
            "user_viewable": true,
            "user_editable": false,
            "rules": "nullable|string|max:80",
            "field_type": "text"
        },
        {
            "name": "Steam username",
            "description": "Leave empty for anonymous. Use only if this game/branch requires login; environment is visible to server owners.",
            "env_variable": "STEAM_USERNAME",
            "default_value": "",
            "user_viewable": true,
            "user_editable": false,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        },
        {
            "name": "Steam password",
            "description": "Optional Steam login credential. Unattended Steam Guard login requires a pre-authorized session.",
            "env_variable": "STEAM_PASSWORD",
            "default_value": "",
            "user_viewable": true,
            "user_editable": false,
            "rules": "nullable|string|max:128",
            "field_type": "text"
        }
    ]
}
